# ollama | anthropic | mock | disabled. Empty means ollama, even when ANTHROPIC_API_KEY is set.
# Set anthropic to use Claude (needs ANTHROPIC_API_KEY). mock is the offline keyword model used by tests.
AI_MODE=
# Only used when AI_MODE=anthropic.
ANTHROPIC_API_KEY=

# Anthropic models: classification, then drafts and incident briefs.
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5

# Ollama models. `make services` pulls them.
OLLAMA_MODEL_FAST=qwen3:8b
OLLAMA_MODEL_SMART=qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434
# Context window. Ollama's default can cut off the playbook in draft prompts.
OLLAMA_NUM_CTX=16384

# Playbook search. keyword (BM25), hybrid (BM25 plus embeddings from a local Ollama model), or auto: hybrid once the
# playbook has KB_HYBRID_MIN_DOCS documents, in Ollama mode only. Hybrid finds paraphrased requests keyword search
# misses (`npm run eval:retrieval`). Text sent for embeddings stays on this machine.
KB_SEARCH=auto
KB_HYBRID_MIN_DOCS=40
OLLAMA_EMBED_MODEL=nomic-embed-text
# Similarity floors for nomic-embed-text: an embedding-only match needs 0.6, a keyword match 0.5 (which drops keyword
# noise on unrelated text). Recalibrate with `npm run eval:retrieval` when changing the model.
KB_MIN_SIMILARITY=0.6
KB_KEYWORD_MIN_SIMILARITY=0.5

# Per model call. Empty means 30000 for Anthropic and 180000 for Ollama (local calls queue behind each other).
AI_TIMEOUT_MS=
TICKET_TOKEN_BUDGET=20000

PORT=8787
# Only this computer can open Zoltar by default. It has no login, so set HOST=0.0.0.0 only on a trusted network.
HOST=
# Host names (comma separated) other than localhost that may reach Zoltar, e.g. zoltar.office.lan. IP addresses
# always work. Anything else is refused, which blocks DNS rebinding attacks from web pages.
ALLOWED_HOSTS=
DB_PATH=data/zoltar.db
LOG_LEVEL=info
# Seed 12 demo clients and ~40 requests when the database is empty.
SEED_ON_START=true

CONFIDENCE_THRESHOLD=0.7
INCIDENT_WINDOW_MINUTES=60
INCIDENT_MIN_TICKETS=5
INCIDENT_MIN_CLIENTS=3
CLIENT_WATCH_MIN_TICKETS=3

WORKER_CONCURRENCY=2
WORKER_POLL_MS=250
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=2000

# Mock model only: simulated latency and the share of calls that fail (0 to 1).
MOCK_LATENCY_MS=400
MOCK_FAIL_RATE=0

MONITOR_ENABLED=true
MONITOR_INTERVAL_MS=10000
# How long a platform must stay degraded before an incident opens (an outage opens at once), and how long it must
# stay operational before recovery is noted. Durations, so "Run checks now" cannot speed either up.
MONITOR_DEGRADED_MS=20000
MONITOR_RECOVERY_MS=30000
# Platforms not listed use the simulated source, controlled from the Platforms page.
# MONITOR_SOURCES={"X":{"type":"statuspage","url":"https://status.example.com/api/v2/status.json"},"Instagram":{"type":"http_probe","url":"https://graph.example.com/health","degradedMs":2000}}
MONITOR_SOURCES=
